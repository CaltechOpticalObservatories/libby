# Rendered from libby's telemetry backend; edits here are lost on the next install.

[Unit]
Description=@display_name@ telemetry: Tempo
After=network-online.target @name@-prometheus.service
Wants=network-online.target

[Service]
Type=simple
User=@user@
Group=@user@
ExecStart=@bin@/tempo -config.file=@etc@/tempo.yaml
Restart=on-failure
RestartSec=5
SyslogIdentifier=@name@-tempo
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@data@/tempo

[Install]
WantedBy=multi-user.target
